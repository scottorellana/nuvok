<?xml version="1.0" encoding="utf-8"?>
<!-- Android bloquea HTTP sin cifrar por defecto. Solo lo permitimos hacia
     el propio dispositivo (127.0.0.1), donde vive el servidor interno de
     contenido que alimenta la Biblioteca (videos/audio de los ZIM).
     Todo el tráfico externo sigue exigiendo HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
