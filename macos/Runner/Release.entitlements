<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox disabled: Prepper Pad is distributed outside the App Store
	     (Hermes-style .dmg) and needs the user's PrepperPad library folder,
	     internal child processes (llama-server), and loopback networking. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- GPS/location for the offline map ("mi ubicación"). -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Prepper Mesh (BLE transport): access to the Bluetooth radio. -->
	<key>com.apple.security.device.bluetooth</key>
	<true/>
</dict>
</plist>
