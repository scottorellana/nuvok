# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock

# macOS
**/Pods/
**/.symlinks/
**/xcuserdata/
.DS_Store

# Native artifacts bundled at build time (fetched/compiled by scripts)
native/out/

# Test fixture is intentionally committed (small mini-Wikipedia ZIM)
!test/fixtures/mini.zim

# Build artifacts
dist/
android/.kotlin/
installer-server/downloads/
native/work/

# Contenido pesado del canal directo (GBs, >límite de GitHub);
# se puebla con scripts/build_country.sh / update_bundle_manifest.py.
# zim/ se ignora por CONTENIDO (/*), no por directorio: así la excepción de
# la Wikipedia mini puede funcionar (git no des-ignora dentro de un
# directorio excluido).
assets/bundled_library/zim/*
assets/bundled_library/maps/
assets/bundled_library/models/
assets/bundled_library/models_xl/
# La Wikipedia mini SÍ se versiona: pubspec la declara como asset del build
# (4.3 MB); sin ella un clon fresco no compila.
!assets/bundled_library/zim/wikipedia_mini.zim

# --- Firmas y secretos: NUNCA deben entrar al repositorio ---
*.jks
*.keystore
key.properties
android/key.properties
*.p12
*.mobileprovision
.env
# Volcados de memoria/diagnóstico de la JVM (pueden contener secretos en RAM)
*.hprof
